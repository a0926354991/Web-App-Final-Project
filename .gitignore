# Python 虛擬環境
.venv/
venv/
ENV/
env/

# Python 快取檔案
__pycache__/
*.py[cod]
*$py.class

# macOS 系統檔案
.DS_Store

# IDE 設定 (VS Code)
.vscode/

# 環境變數/私密資訊 (如果你之後有用到 API Key)
.env

# SQLite 資料庫 (由 ingest 腳本產生)
backend/data/*.db
backend/data/*.db-journal
backend/data/*.db.bak.*

# 排程器 lock 檔
.claude/scheduled_tasks.lock

# Skill driver 產生的截圖 (每次 smoke 重產,不入庫)
.claude/skills/*/screenshots/